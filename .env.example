# --- database ---
# Inside docker compose the host is "db"; from the host machine it is "localhost".
DATABASE_URL=postgresql://docsrag:docsrag@db:5432/docsrag

# --- embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
# "sentence-transformers" for the real model, "hash" for the offline test double
EMBEDDER=sentence-transformers

# --- chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- retrieval ---
TOP_K=5

# --- generation ---
# One of: anthropic | openai | ollama | echo
# "echo" needs no API key and returns the assembled context verbatim; it exists so the
# service (and the test suite) runs end-to-end with zero credentials.
LLM_PROVIDER=echo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
